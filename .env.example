# Copy this file to .env.local and fill in what you need.
# The editor runs without any of these — you just don't get the AI copilot.

# ── Modela copilot ────────────────────────────────────────────────────────────

# Required for the copilot. Get one at https://openrouter.ai/keys
# Stays server-side: it is read in app/api/copilot/route.ts and never bundled.
OPENROUTER_API_KEY=

# Which provider adapter to use: openrouter (default) or mock.
# mock is deterministic and needs no key — useful for tests and demos.
# MODELA_AI_PROVIDER=openrouter

# Any OpenRouter model slug. Must support tool calling; must support vision
# for image attachments to work.
# MODELA_AI_MODEL=anthropic/claude-sonnet-4.5

# Separate model for image analysis. Defaults to MODELA_AI_MODEL.
# MODELA_AI_VISION_MODEL=

# Cap on agent loop iterations per turn. Guards against runaway cost.
# MODELA_AI_MAX_STEPS=24

# Restrict the model picker — and the server — to models that cost nothing.
# Enforced in app/api/copilot: a limit the client can bypass is not a limit.
# MODELA_AI_FREE_ONLY=1

# Point the OpenRouter adapter at a different OpenAI-compatible gateway.
# MODELA_AI_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

# ── Editor (upstream Pascal) ─────────────────────────────────────────────────

# Dev server port (default: 3002, set in .env.defaults)
# PORT=3002

# Public editor origin used by Mint OAuth and same-origin checks.
# Set this when the editor is hosted outside editor.pascal.app.
# MINT_PASCAL_HOST_ORIGIN=https://modela.example.com
